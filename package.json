{
  "name": "dr-doc",
  "private": true,
  "version": "1.0.0",
  "description": "Dr.Doc - offline document toolkit",
  "author": "Dr.Doc",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "predev": "node scripts/copy-ocr-assets.mjs",
    "dev": "vite --host",
    "prebuild": "node scripts/copy-ocr-assets.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "desktop": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder --win portable",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "test:fixtures": "node tests/make-fixtures.mjs",
    "test:smoke": "electron tests/run-smoke.cjs"
  },
  "build": {
    "appId": "com.drdoc.app",
    "productName": "Dr.Doc",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "public/icon-512.png"
    },
    "portable": {
      "artifactName": "Dr.Doc-${version}-portable.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Dr.Doc-${version}-setup.exe"
    },
    "fileAssociations": [
      {
        "ext": "pdf",
        "name": "PDF",
        "role": "Viewer"
      },
      {
        "ext": "docx",
        "name": "Word document",
        "role": "Viewer"
      }
    ]
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/cli": "^7.6.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/turndown": "^5.0.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.10",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4",
    "@capawesome-team/capacitor-file-opener": "^7.0.1",
    "@tesseract.js-data/eng": "^1.0.0",
    "@tesseract.js-data/hin": "^1.0.0",
    "cfb": "^1.2.2",
    "docx": "^9.0.3",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.8.0",
    "marked": "^14.1.4",
    "pdfjs-dist": "^4.10.38",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0",
    "turndown": "^7.2.0",
    "xlsx": "^0.18.5"
  }
}
